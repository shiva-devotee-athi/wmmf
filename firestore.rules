rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can submit a contact message, but only signed-in admins can
    // read, update (mark read), or delete them.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // News, members, documents, and media are publicly readable (the
    // marketing site reads them) but only signed-in admins can write.
    match /news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /members/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /documents/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mediaPhotos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mediaVideos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
